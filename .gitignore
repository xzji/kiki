# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# nested package deps & build output
packages/*/node_modules
packages/*/dist

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local SQLite runtime data & all tenant workspaces
/data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.dbg/
/debug-*.md

# secrets & local env (never commit)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# railway CLI local link state
.railway/

# local agent workspace documents
/.trae/

# project documents are kept outside git
/docs/

# local analysis exports
/Trump_Donald_J_2026_278T2*
