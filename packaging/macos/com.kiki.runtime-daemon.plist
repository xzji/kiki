<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.kiki.runtime-daemon</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd __PROJECT_ROOT__ &amp;&amp; pnpm exec tsx scripts/start-worker.ts</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__RUNTIME_LOG_DIR__/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__RUNTIME_LOG_DIR__/launchd.stderr.log</string>
  </dict>
</plist>
